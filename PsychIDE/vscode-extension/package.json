{
  "name": "psych-ide",
  "displayName": "Psych Engine IDE",
  "description": "Complete development environment for Psych Engine v1.0.4 modding",
  "version": "0.1.0",
  "publisher": "PsychModding",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers"
  ],
  "keywords": [
    "psych-engine",
    "fnf",
    "lua",
    "haxe",
    "modding"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lua",
        "extensions": [
          ".lua"
        ],
        "aliases": [
          "Lua"
        ]
      }
    ],
    "grammars": [
      {
        "language": "lua",
        "scopeName": "source.lua",
        "path": "./syntaxes/lua.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/psych-snippets.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "song.json",
        "url": "./schemas/song.schema.json"
      },
      {
        "fileMatch": "character.json",
        "url": "./schemas/character.schema.json"
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "variable": "#8BE9FD",
          "function": "#50FA7B",
          "keyword": "#FF79C6",
          "string": "#F1FA8C",
          "number": "#BD93F9",
          "type": "#FFB86C",
          "engine": "#00FFCC" 
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "name": "Psych Engine API Functions and Callbacks",
            "scope": [
              "support.function.lua",
              "entity.name.function.lua",
              "entity.name.function.haxe",
              "support.function.haxe"
            ],
            "settings": {
              "foreground": "#00FFCC",
              "fontStyle": "bold"
            }
          }
        ]
      },
      "[haxe]": {
        "editor.semanticTokenColorCustomizations": {
          "rules": {
            "variable": "#8BE9FD",
            "function": "#50FA7B",
            "keyword": "#FF79C6",
            "string": "#F1FA8C",
            "number": "#BD93F9",
            "type": "#FFB86C"
          }
        }
      }
    },
    "commands": [
      {
        "command": "psychIde.validateLua",
        "title": "Psych: Validate Lua File"
      },
      {
        "command": "psychIde.validateJson",
        "title": "Psych: Validate JSON File"
      },
      {
        "command": "psychIde.generateSnippet",
        "title": "Psych: Generate Code Snippet"
      },
      {
        "command": "psychIde.showOutput",
        "title": "PsychIDE: Show Server Output Logs"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "activationEvents": [
    "onLanguage:lua",
    "onCommand:psychIde.showOutput"
  ]
}