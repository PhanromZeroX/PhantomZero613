{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "outDir": "out",
        "lib": ["es2022"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", ".vscode-test"]
}
